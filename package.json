{
  "name": "compass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.mjs",
    "test": "node --test test/",
    "test:live": "node --env-file=.env --test test/live/",
    "probe:nebius": "node --env-file=.env scripts/nebius-probe.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.8.3",
    "vite": "7.3.6"
  }
}
